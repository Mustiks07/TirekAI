# PostgreSQL is required for shared environments. Never commit real credentials.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
# Local-only, synthetic data. npm run dev / preview set these automatically.
LOCAL_DATABASE=0
LOCAL_PREVIEW=0
PGLITE_DATA_DIR=.data/local
# T026: server-side only; empty = assistant not_configured.
ANTHROPIC_API_KEY=
# free (Gemma -> Nemotron), gemini (Gemma only), openrouter (free-only), anthropic, disabled. Empty model uses the provider default.
ASSISTANT_PROVIDER=disabled
ASSISTANT_MODEL=
OPENROUTER_API_KEY=
# Allow provider data collection ONLY for a synthetic local demo; requires LOCAL_PREVIEW=1,
# LOCAL_DATABASE=1 and no DATABASE_URL. Otherwise data collection is denied.
ASSISTANT_SYNTHETIC_DATA=0
# Google key is used only for allowlisted free Gemma 4 models, in synthetic local mode.
GEMINI_API_KEY=
# Reserved: xAI generation is not enabled.
XAI_API_KEY=
# T029: 32 random bytes, base64. Without it integration credentials are not stored.
INTEGRATION_ENCRYPTION_KEY=
# Optional for tests in containers with a preinstalled browser build.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# T051/T053 operations.
# Connections per process; keep processes * pool below PostgreSQL max_connections.
DATABASE_POOL_MAX=10
# 32 random bytes, base64: encrypts backups (npm run db:backup). Store apart from the backups.
BACKUP_ENCRYPTION_KEY=
# PostgreSQL client tools (pg_dump/pg_restore) directory if not on PATH.
PG_BIN=
# Target of npm run db:restore (an EMPTY database).
RESTORE_DATABASE_URL=
# Retention of operational data, days (npm run ops:retention). Business history is never trimmed.
RETENTION_INBOX_PAYLOAD_DAYS=30
RETENTION_SYNC_RUN_DAYS=180
RETENTION_READ_NOTIFICATION_DAYS=90
RETENTION_MESSAGING_LINK_DAYS=30
RETENTION_AUTOMATION_TEST_DAYS=180
RETENTION_INSIGHT_RUN_DAYS=180
