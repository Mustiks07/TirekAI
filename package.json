{
  "name": "smb-ai-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "preview": "node scripts/local.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:load": "tsx scripts/load-test.ts",
    "measure:files": "tsx scripts/measure-files.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:business": "tsx scripts/seed-business.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "test:restore": "tsx scripts/restore-drill.ts",
    "ops:retention": "tsx scripts/retention.ts",
    "org:export": "tsx scripts/export-org.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "live:report": "tsx scripts/live-report.ts",
    "pilot:metrics": "tsx scripts/pilot-metrics.ts",
    "ocr:check": "tsx scripts/ocr-check.ts",
    "voice:check": "tsx scripts/voice-check.ts",
    "video:probe": "tsx scripts/video-probe.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "format": "prettier --write src tests scripts *.ts *.mjs",
    "eval:assistant": "tsx --env-file-if-exists=.env.local scripts/assistant-eval.ts",
    "eval:video": "tsx scripts/video-eval.ts",
    "video:processor": "tsx scripts/video-processor.ts"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@electric-sql/pglite": "0.5.9",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@napi-rs/canvas": "1.0.11",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kaz": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "type": "module"
}
