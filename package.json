{
  "name": "smb-ai-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "preview": "node scripts/local.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "format": "prettier --write src tests scripts *.ts *.mjs"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@fontsource-variable/noto-sans": "5.3.0",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "type": "module"
}
