        { "any": ["не проводи"], "critical": true },
        { "any": ["черновик"] }
      ]
    },
    {
      "id": "ru-12",
      "locale": "ru",
      "text": "Спиши двадцать пять штук хлеба",
      "keys": [
        { "any": ["25", "двадцать пять"], "critical": true },
        { "any": ["хлеб"] }
      ]
    },
    {
      "id": "kk-01",
      "locale": "kk",
      "text": "Негізгі қоймада қара шай қанша қалды?",
