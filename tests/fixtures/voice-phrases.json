        { "any": ["5000", "бес мың"], "critical": true },
        { "any": ["теңге", "тг"] }
      ]
    },
    {
      "id": "kk-08",
      "locale": "kk",
      "text": "Соңғы аптадағы сатылым қандай?",
      "keys": [{ "any": ["сатылым"] }, { "any": ["апта"] }]
    },
    {
      "id": "kk-09",
      "locale": "kk",
      "text": "Қоймада жарамдылық мерзімі өтіп жатқан тауар бар ма?",
      "keys": [{ "any": ["мерзім"] }, { "any": ["тауар"] }]
    },
    {
      "id": "kk-10",
      "locale": "kk",
      "text": "Ерлан деген клиенттің соңғы тапсырысын тап",
      "keys": [{ "any": ["ерлан"], "critical": true }, { "any": ["тапсырыс"] }]
    },
    {
      "id": "kk-11",
      "locale": "kk",
      "text": "Төлемді жүргізбе, тек жобасын дайында",
      "keys": [{ "any": ["жүргізбе"], "critical": true }, { "any": ["жоба"] }]
