    },
    {
      "id": "ru-07",
      "locale": "ru",
      "text": "Покажи расходы больше пяти тысяч тенге",
      "keys": [
        { "any": ["5000", "пяти тысяч"], "critical": true },
        { "any": ["тенге", "тг"] }
      ]
    },
    {
      "id": "ru-08",
      "locale": "ru",
      "text": "Какие продажи за последнюю неделю?",
      "keys": [{ "any": ["продажи"] }, { "any": ["неделю"] }]
    },
    {
      "id": "ru-09",
      "locale": "ru",
      "text": "Есть ли на складе товары с истекающим сроком годности?",
      "keys": [{ "any": ["срок"] }, { "any": ["годности"] }]
    },
    {
      "id": "ru-10",
      "locale": "ru",
      "text": "Найди последний заказ клиента Ерлана",
      "keys": [{ "any": ["ерлан"], "critical": true }, { "any": ["заказ"] }]
    },
    {
      "id": "ru-11",
      "locale": "ru",
      "text": "Не проводи оплату, только подготовь черновик",
