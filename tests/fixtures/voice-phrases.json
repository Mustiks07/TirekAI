    },
    {
      "id": "kk-02",
      "locale": "kk",
      "text": "Бүгін қанша тапсырыс жабылды?",
      "keys": [{ "any": ["тапсырыс"] }, { "any": ["бүгін"] }]
    },
    {
      "id": "kk-03",
      "locale": "kk",
      "text": "Жеткізушіге он екі қорап сүтке тапсырыс дайында",
