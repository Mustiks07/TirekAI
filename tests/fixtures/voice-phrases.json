        { "any": ["айгүл", "айгуль"], "critical": true },
        { "any": ["витрина"] }
      ]
    },
    {
      "id": "kk-07",
      "locale": "kk",
      "text": "Бес мың теңгеден асатын шығындарды көрсет",
